{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "candidate_total": {
          "default": 0,
          "title": "Candidate Total",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "enum": [
            "laws",
            "precedents",
            "admrules",
            "ordinances"
          ],
          "title": "Dataset",
          "type": "string"
        },
        "github_url": {
          "title": "Github Url",
          "type": "string"
        },
        "original_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Url"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "ref_type": {
          "enum": [
            "commit",
            "unknown"
          ],
          "title": "Ref Type",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "repository",
        "path",
        "ref_type",
        "github_url"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "kind": {
      "const": "error",
      "default": "error",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorResult",
  "type": "object"
}
